@model Proyector;

@{
    ViewData["Title"] = "Eliminar proyector";
}

<div class="container">
    <h2 class="display-6 mb-3">información del Proyector #@Model.Id</h2>

    <div class="bg-body-secondary p-3 mb-5 fs-5">

    <div>
        <div class="form-group col">
            <label class="form-label">Marca:</label>
            <span class="form-label">@Model.Marca</span>
        </div>
        <div class="form-group col">
            <label class="form-label">Modelo:</label>
            <span class="form-label">@Model.Modelo</span>
        </div>
    </div>
    <div >
        <div class="form-group">
            <label class="form-label">Numero de serie:</label>
            <span class="form-label">@Model.NumeroDeSerie</span>
        </div>
        <div class="form-group">
            <label class="form-label">Situacion:</label>
            <span class="form-label">@Model.Situacion</span>
        </div>
    </div>
    <div class="row">
        <div class="form-group col">
            <label class="form-label">Fecha de alta:</label>
            <span class="form-label">@Model.FechaDeAlta.ToShortDateString()</span>
        </div>
        <div class="form-group col">
            <label class="form-label">Fecha de baja:</label>
            <span class="form-label">@Model.FechaDeBaja?.ToShortDateString()</span>
        </div>
        <div class="form-group col">
            <label class="form-label">Situacion:</label>
            <span class="form-label">@Model.Situacion</span>
        </div>
    </div>
    </div>

    <form method="post" asp-controller="Home" asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-end">
            <a class="btn btn-primary mx-2" asp-controller="Home" asp-action="Index">Cancelar</a>
            <button type="submit" class="btn btn-danger mx-2" asp-route-id="@Model.Id">Eliminar</button>
        </div>
    </form>

</div>
